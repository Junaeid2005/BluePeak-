{
  "entities": {
    "inquiry": {
      "title": "Inquiry",
      "description": "Client contact inquiry and project request submitted via the BluePeak website",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the visitor",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Email address of the visitor",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "company": {
          "type": "string",
          "description": "Optional business name",
          "maxLength": 120
        },
        "service": {
          "type": "string",
          "description": "Primary service interested in",
          "minLength": 2,
          "maxLength": 80
        },
        "budget": {
          "type": "string",
          "description": "Optional estimated budget range",
          "maxLength": 60
        },
        "message": {
          "type": "string",
          "description": "Project details",
          "minLength": 10,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "description": "Inquiry workflow status",
          "enum": ["new"]
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp when inquiry was created"
        }
      },
      "required": ["name", "email", "service", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "/inquiries/{inquiryId}": {
      "schema": "inquiry",
      "description": "Write-only incoming client inquiries collection secured against unauthorized reads, updates, and deletes"
    }
  }
}
